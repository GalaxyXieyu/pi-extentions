{
  "name": "@galaxyxieyu/pi-viking-memory",
  "version": "0.2.10",
  "description": "A unified Pi memory extension for Viking Memory and OpenViking with workspace isolation, global preferences, lifecycle controls, audit, and TUI memory cards.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "memory",
    "viking-memory",
    "openviking",
    "ai-memory"
  ],
  "files": [
    "index.ts",
    "README.md",
    "docker-compose.openviking.yml",
    "core/*.ts",
    "core/*.js",
    "core/*.mjs",
    "core/*.json",
    "core/*.md",
    "core/tui/*.ts",
    "providers/openviking/*.ts",
    "providers/openviking/*.mjs",
    "providers/openviking/config.json",
    "providers/openviking/lib/*.mjs",
    "providers/openviking/shared/*.mjs",
    "providers/viking-memory/*.ts",
    "providers/viking-memory/config.json",
    "docs/**/*.md"
  ],
  "scripts": {
    "test": "vitest run --root ../.. --config vitest.config.ts"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
